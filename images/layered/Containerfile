ARG FRAPPE_BRANCH=v16.17.0
ARG FRAPPE_IMAGE_PREFIX=frappe
# Tag for the upstream frappe/build and frappe/base images we layer on top of.
# Decoupled from FRAPPE_BRANCH because Frappe Cloud sometimes publishes the
# base image (frappe/base:vX) before the build image (frappe/build:vX), so
# pinning a brand-new Frappe release here would 404 on Docker Hub. We pull the
# build/base images at a known-published tag and let bench init clone the
# actual Frappe code at FRAPPE_BRANCH.
ARG BASE_IMAGE_TAG=v16.16.0

FROM ${FRAPPE_IMAGE_PREFIX}/build:${BASE_IMAGE_TAG} AS builder

ARG FRAPPE_BRANCH=v16.17.0
ARG FRAPPE_PATH=https://github.com/frappe/frappe

USER frappe

RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=1000 \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS}\
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

FROM ${FRAPPE_IMAGE_PREFIX}/base:${BASE_IMAGE_TAG} AS backend

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

# Stash assets at a path *outside* the volume mount so the configurator can
# refresh the shared `sites` volume on every startup. Without this, Docker's
# named-volume semantics keep whatever assets.json populated the volume on
# first creation — newer images with different bundle hashes get hidden, and
# every redeploy 404s the CSS until someone runs a manual sync.
#
# The `assets/` directory is mostly symlinks into apps/<name>/public, so what
# we really care about preserving across deploys is `assets.json` (the
# bundle-hash → path manifest). Stashing the whole directory keeps it simple
# and lets the configurator overwrite via cp -rf below.
USER root
RUN cp -a /home/frappe/frappe-bench/sites/assets /opt/frappe-baked-assets && \
  chown -R frappe:frappe /opt/frappe-baked-assets
USER frappe

WORKDIR /home/frappe/frappe-bench

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

CMD [ \
  "/home/frappe/frappe-bench/env/bin/gunicorn", \
  "--chdir=/home/frappe/frappe-bench/sites", \
  "--bind=0.0.0.0:8000", \
  "--threads=4", \
  "--workers=2", \
  "--worker-class=gthread", \
  "--worker-tmp-dir=/dev/shm", \
  "--timeout=120", \
  "--preload", \
  "frappe.app:application" \
]
