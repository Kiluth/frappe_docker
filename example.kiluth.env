# Kiluth-specific .env template. Copy to .env on a new dev machine:
#   cp example.kiluth.env .env
# This matches the local-dev setup — nothing in here is sensitive; the DB
# only listens on the internal Docker network. Update DB_PASSWORD if you
# want, it's isolated per-machine.
#
# For the generic upstream reference, see: example.env

# Pin compose project name so the folder this file lives in can be renamed
# without orphaning containers, volumes, or networks.
COMPOSE_PROJECT_NAME=kiluth-portal

# --- Custom image (built from our apps.json) ---
# We build locally with this name+tag; docker-compose picks it up instead
# of the default frappe/erpnext image.
CUSTOM_IMAGE=kiluth-erpnext
CUSTOM_TAG=v16.17.0-local
# NOTE: ERPNEXT_VERSION is a misleading name — the workflow uses this value
# as FRAPPE_BRANCH (the *Frappe* git ref that bench installs). ERPNext
# itself is pinned via apps.json. Bump this to track the Frappe release
# that contains whatever symbols apps.json's erpnext branch expects to
# import (e.g. ERPNext 16.16.0 imports XLSXMetadata, which only exists in
# Frappe 16.17.0+).
ERPNEXT_VERSION=v16.17.0

# Don't try to pull from a remote registry — use the locally-built image.
PULL_POLICY=never

# --- Site routing ---
# The site is named "kiluth.localhost" and accessed at
# http://kiluth.localhost:8080 (or http://localhost:8080 — either resolves).
FRAPPE_SITE_NAME_HEADER=kiluth.localhost
HTTP_PUBLISH_PORT=8080

# --- Database ---
# Local-dev password. Not sensitive — container only listens on internal
# Docker network.
DB_PASSWORD=kiluth-local-dev

# --- Compose file chain ---
# Auto-applied to every `docker compose ...` command in this directory.
# dev-app bind-mounts ./kiluth_portal into the Python services so edits on
# the host are live in the container.
COMPOSE_FILE=compose.yaml:overrides/compose.mariadb.yaml:overrides/compose.redis.yaml:overrides/compose.noproxy.yaml:overrides/compose.dev-app.yaml
